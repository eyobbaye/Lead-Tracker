{
  "manifest_version": 3,
  "version": "1.0",
  "name": "Leads tracker",
  "permissions": ["tabs", "storage", "activeTab"],

  "action": {
    "default_popup": "index.html",
    "default_icon": "icon.png"
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
